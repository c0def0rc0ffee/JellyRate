<?xml version="1.0" encoding="UTF-8"?>
<!--
  <summary>
  Skin for the My Ratings browser window: a panel with a header (600), a
  hint line (601), column headings, the list (500) and a Close button
  (700). Control ids must match ratings_list.py.
  </summary>
-->
<window type="dialog">
    <defaultcontrol always="true">500</defaultcontrol>
    <zorder>9999</zorder>
    <coordinates>
        <system>1</system>
        <posx>360</posx>
        <posy>140</posy>
    </coordinates>
    <controls>
        <!-- Panel background -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1200</width>
            <height>800</height>
            <texture colordiffuse="F0141821">jellyrate-dim.png</texture>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1200</width>
            <height>6</height>
            <texture colordiffuse="FF45B6FE">jellyrate-dim.png</texture>
        </control>

        <control type="label" id="600">
            <left>40</left>
            <top>26</top>
            <width>1120</width>
            <height>40</height>
            <font>font36</font>
            <align>left</align>
            <textcolor>FFFFFFFF</textcolor>
            <label>JellyRate</label>
        </control>
        <control type="label" id="601">
            <left>40</left>
            <top>78</top>
            <width>1120</width>
            <height>28</height>
            <font>font12</font>
            <align>left</align>
            <textcolor>FF9AA6B2</textcolor>
            <label>Select an item to rate</label>
        </control>

        <!-- Column headers -->
        <control type="label">
            <left>60</left>
            <top>118</top>
            <width>760</width>
            <height>30</height>
            <font>font12</font>
            <align>left</align>
            <textcolor>FF6E7A88</textcolor>
            <label>TITLE</label>
        </control>
        <control type="label">
            <left>820</left>
            <top>118</top>
            <width>180</width>
            <height>30</height>
            <font>font12</font>
            <align>right</align>
            <textcolor>FF6E7A88</textcolor>
            <label>LAST PLAYED</label>
        </control>
        <control type="label">
            <left>1010</left>
            <top>118</top>
            <width>130</width>
            <height>30</height>
            <font>font12</font>
            <align>right</align>
            <textcolor>FF6E7A88</textcolor>
            <label>RATING</label>
        </control>

        <control type="list" id="500">
            <left>40</left>
            <top>156</top>
            <width>1120</width>
            <height>560</height>
            <onup>500</onup>
            <ondown>500</ondown>
            <onleft>700</onleft>
            <onright>700</onright>
            <pagecontrol>-</pagecontrol>
            <scrolltime>200</scrolltime>
            <itemlayout width="1120" height="56">
                <control type="label">
                    <left>20</left>
                    <top>0</top>
                    <width>760</width>
                    <height>56</height>
                    <font>font13</font>
                    <align>left</align>
                    <aligny>center</aligny>
                    <textcolor>FFD8DEE4</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>780</left>
                    <top>0</top>
                    <width>180</width>
                    <height>56</height>
                    <font>font12</font>
                    <align>right</align>
                    <aligny>center</aligny>
                    <textcolor>FF9AA6B2</textcolor>
                    <label>$INFO[ListItem.Property(date)]</label>
                </control>
                <control type="label">
                    <left>970</left>
                    <top>0</top>
                    <width>130</width>
                    <height>56</height>
                    <font>font13</font>
                    <align>right</align>
                    <aligny>center</aligny>
                    <textcolor>FF45B6FE</textcolor>
                    <label>$INFO[ListItem.Label2]</label>
                </control>
            </itemlayout>
            <focusedlayout width="1120" height="56">
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>1120</width>
                    <height>56</height>
                    <texture colordiffuse="3345B6FE">jellyrate-dim.png</texture>
                </control>
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>4</width>
                    <height>56</height>
                    <texture colordiffuse="FF45B6FE">jellyrate-dim.png</texture>
                </control>
                <control type="label">
                    <left>20</left>
                    <top>0</top>
                    <width>760</width>
                    <height>56</height>
                    <font>font13</font>
                    <align>left</align>
                    <aligny>center</aligny>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>780</left>
                    <top>0</top>
                    <width>180</width>
                    <height>56</height>
                    <font>font12</font>
                    <align>right</align>
                    <aligny>center</aligny>
                    <textcolor>FFD8DEE4</textcolor>
                    <label>$INFO[ListItem.Property(date)]</label>
                </control>
                <control type="label">
                    <left>970</left>
                    <top>0</top>
                    <width>130</width>
                    <height>56</height>
                    <font>font13</font>
                    <align>right</align>
                    <aligny>center</aligny>
                    <textcolor>FF8FD0FE</textcolor>
                    <label>$INFO[ListItem.Label2]</label>
                </control>
            </focusedlayout>
        </control>

        <control type="button" id="700">
            <left>980</left>
            <top>728</top>
            <width>180</width>
            <height>52</height>
            <texturefocus colordiffuse="FF45B6FE">jellyrate-dim.png</texturefocus>
            <texturenofocus colordiffuse="33FFFFFF">jellyrate-dim.png</texturenofocus>
            <font>font13</font>
            <align>center</align>
            <textcolor>FFFFFFFF</textcolor>
            <focusedcolor>FF141821</focusedcolor>
            <label>Close</label>
            <onup>500</onup>
            <onleft>500</onleft>
            <onright>500</onright>
        </control>
    </controls>
</window>
